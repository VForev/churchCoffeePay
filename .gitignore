# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# print agent (runs on the shop PC, not on Netlify)
print-agent/node_modules/
print-agent/.env

# NOTE: public/print-agent.zip is intentionally COMMITTED (not ignored) so it can
# be downloaded straight from GitHub as well as from /admin/print-setup. It's
# rebuilt deterministically on predev/prebuild, so a rebuild produces identical
# bytes and never shows up as a spurious change.
