# Copy this file to `.env` (same folder) and fill it in.

# Same two values as the website's .env.local — copy them across.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional. Only needed if the anon key can't update orders under your RLS rules.
SUPABASE_SERVICE_ROLE_KEY=

# Leave blank to use the Windows default printer. Otherwise paste the printer's
# EXACT name from Windows Settings → Bluetooth & devices → Printers & scanners.
PRINTER_NAME=

# On startup, print any unprinted orders from the last N hours.
CATCHUP_HOURS=6

# Troubleshooting: set to 1 to keep each generated PDF instead of deleting it, and
# print its file path. Open one to see whether a blank label is the PDF or the printer.
KEEP_PDF=

# NOTE: label size and layout are NOT set here. They're edited at /admin/labels in
# the browser, stored in the database, and picked up by this agent the moment you
# save — so nobody has to come back to this PC to change the roll size.
