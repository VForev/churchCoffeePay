# Copy this file to `.env` (same folder) and fill it in.

# Same two values as the website's .env.local — copy them across.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional. Only needed if the anon key can't update orders under your RLS rules.
SUPABASE_SERVICE_ROLE_KEY=

# Leave blank to use the computer's default printer. Otherwise paste the printer's
# EXACT name. Windows: Settings → Printers & scanners. Mac: run `lpstat -e` in
# Terminal (e.g. Clabel__CT221B).
PRINTER_NAME=

# The printer's paper/label size, BY NAME. This is what stops a label feeding out
# blank: the printer has to be told the media is (e.g.) 40 × 30 mm. Leave it blank
# and the agent auto-picks the size matching your label. If that doesn't work, run
# `npm run doctor` to list the exact size names your printer offers, and paste the
# right one here (e.g. 40mm x 30mm).
PRINTER_PAPER_SIZE=

# On startup, print any unprinted orders from the last N hours.
CATCHUP_HOURS=6

# Troubleshooting: set to 1 to keep each generated PDF instead of deleting it, and
# print its file path. Open one to see whether a blank label is the PDF or the printer.
KEEP_PDF=

# NOTE: label size and layout are NOT set here. They're edited at /admin/labels in
# the browser, stored in the database, and picked up by this agent the moment you
# save — so nobody has to come back to this PC to change the roll size.
